# Copy this file to .env and fill in your values
# NEVER commit .env to git

PORT=4000
NODE_ENV=development

# MongoDB — local or Atlas
# Local:  MONGO_URI=mongodb://127.0.0.1:27017/dungeon-escape
# Atlas:  MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dungeon-escape?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb://127.0.0.1:27017/dungeon-escape

# Session — must be at least 32 characters; generate with: openssl rand -hex 32
SESSION_SECRET=your-32-char-minimum-session-secret-here-123456789

CLIENT_ORIGIN=http://localhost:5173

# Banana API Integration endpoint (University of Bedfordshire)
BANANA_URL=https://marcconrad.com/uob/banana/api.php

# Game rules
MAX_ATTEMPTS=3
PUZZLE_TTL_S=300
COOLDOWN_S=30
MIN_COMPLETION_S=5
